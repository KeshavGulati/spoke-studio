{
  "name": "spoke-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "spoke-studio"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "METADATA",
        "class_name": "MetadataCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MetadataCoordinator"]
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
